# Frontend configuration -- copy to `frontend/.env.local` (never committed).
# Next.js reads this folder's .env files, NOT the repository-root .env.
#
# URL of the FastAPI backend, as seen from the BROWSER. NEXT_PUBLIC_* values
# are compiled into the client JavaScript when `npm run dev` starts: after
# changing it, stop and restart `npm run dev`.
#
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:8000
#
# Public sharing through a Cloudflare Quick Tunnel: put the backend tunnel
# URL printed by `cloudflared tunnel --url http://localhost:8000` here (or in
# $env:NEXT_PUBLIC_API_URL before `npm run dev`). Quick Tunnel URLs change on
# every restart, so update it each time the backend tunnel is recreated.
